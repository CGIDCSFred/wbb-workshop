# Python
__pycache__/
*.pyc
*.pyo
*.pyd
.Python

# Environment
.env
.env.*

# Docker volumes and temp files
*.jsonl

# VS Code
.vscode/

# macOS
.DS_Store

# Demo output directories — kept as empty placeholders.
# spec/ and regenerated/ are populated live during the demo; ignore the
# generated outputs but keep the .gitkeep placeholders tracked.
spec/*
!spec/.gitkeep
regenerated/*
!regenerated/.gitkeep

# SQLite database (generated at runtime)
*.db

# Streamlit secrets (contains API keys)
.streamlit/secrets.toml
